<template>
  <view class="page-container" :class="darkModeClass">
    <view class="user-card">
      <view class="avatar">
        <text class="avatar-icon">👤</text>
      </view>
      <view class="user-info">
        <text class="user-name">{{ userInfo?.nickName || '点击登录' }}</text>
        <text class="user-desc">欢迎使用 houyu-app</text>
      </view>
    </view>
    
    <view class="menu-list" :class="{ 'menu-list-dark': isDark }">
      <view class="menu-item" v-for="item in menuItems" :key="item.key" @click="handleMenuClick(item)">
        <text class="menu-icon">{{ item.icon }}</text>
        <text class="menu-text" :class="{ 'menu-text-dark': isDark }">{{ item.text }}</text>
        <text class="menu-arrow">›</text>
      </view>
    </view>
    
    <view class="footer">
      <text class="version">v{{ version }}</text>
    </view>
  </view>
</template>

<script lang="uts" setup>
  import { computed } from 'vue'
  import { state } from '@/store/index.uts'
  import { darkModeClass } from '@/composables/useDark.uts'

  type MenuItem = {
    key: string
    icon: string
    text: string
  }

  const userInfo = computed(() => state.userInfo)
  const isDark = computed(() => state.isDarkMode)

  const version = computed(() => {
    // #ifdef H5
    try {
      const pkg = require('../../package.json')
      return pkg.version || '1.0.0'
    } catch {
      return '1.0.0'
    }
    // #endif
    // #ifdef APP || MP-WEIXIN
    try {
      const info = uni.getAppBaseInfo()
      return info.appVersion || '1.0.0'
    } catch {
      return '1.0.0'
    }
    // #endif
    return '1.0.0'
  })

  const menuItems: MenuItem[] = [
    { key: 'settings', icon: '⚙️', text: '设置' },
    { key: 'about', icon: 'ℹ️', text: '关于' },
    { key: 'feedback', icon: '💬', text: '意见反馈' }
  ]

  const handleMenuClick = (item: MenuItem) => {
    uni.showToast({
      title: `点击了${item.text}`,
      icon: 'none'
    })
  }

  onLoad(() => {
    // #ifdef DEBUG
    console.log('Mine Page Load')
    // #endif
  })
</script>

<style lang="scss">
  .page-container {
    min-height: 100vh;
    background-color: $uni-bg-color-grey;
    padding-bottom: calc(env(safe-area-inset-bottom) + 100rpx);
  }

  .page-container.theme-dark {
    background-color: #1a1a1a;
  }

  .user-card {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    display: flex;
    align-items: center;
    padding: 40rpx;
    margin-bottom: 20rpx;
  }

  .avatar {
    width: 120rpx;
    height: 120rpx;
    background: rgba(255, 255, 255, 0.2);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-right: 30rpx;
  }

  .avatar-icon {
    font-size: 50rpx;
  }

  .user-info {
    flex: 1;
  }

  .user-name {
    display: block;
    font-size: 36rpx;
    font-weight: 600;
    color: #fff;
    margin-bottom: 8rpx;
  }

  .user-desc {
    font-size: 26rpx;
    color: rgba(255, 255, 255, 0.8);
  }

  .menu-list {
    background: $uni-bg-color;
    margin: 0 20rpx 20rpx;
    border-radius: 16rpx;
    overflow: hidden;
  }

  .menu-list-dark {
    background-color: #2a2a2a;
  }

  .menu-item {
    display: flex;
    align-items: center;
    padding: 30rpx;
    border-bottom: 1rpx solid $uni-border-color;
    
    &:last-child {
      border-bottom: none;
    }
  }

  .menu-icon {
    font-size: 36rpx;
    margin-right: 20rpx;
  }

  .menu-text {
    flex: 1;
    font-size: 30rpx;
    color: $uni-text-color;
  }

  .menu-text-dark {
    color: #fff;
  }

  .menu-arrow {
    font-size: 36rpx;
    color: $uni-text-color-grey;
  }

  .footer {
    text-align: center;
    padding: 40rpx 0;
  }

  .version {
    font-size: 24rpx;
    color: $uni-text-color-grey;
  }
</style>
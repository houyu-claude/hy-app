<template>
  <view class="page-container" :class="darkModeClass" :style="{ paddingBottom: paddingBottomStyle }">
    <view class="user-card" @click="handleUserClick">
      <view class="avatar">
        <image v-if="userInfo?.avatarUrl" :src="userInfo.avatarUrl" class="avatar-image" />
        <text v-else class="avatar-icon">👤</text>
      </view>
      <view class="user-info">
        <text class="user-name">{{ userInfo?.nickName || '点击登录' }}</text>
        <text class="user-desc">{{ userInfo ? '欢迎回来' : '登录享更多功能' }}</text>
      </view>
      <view class="user-arrow" v-if="!userInfo">
        <text class="arrow-icon">›</text>
      </view>
    </view>
    
    <view class="menu-list">
      <view class="menu-item" v-for="item in menuItems" :key="item.key" @click="handleMenuClick(item)">
        <text class="menu-icon">{{ item.icon }}</text>
        <text class="menu-text">{{ item.text }}</text>
        <text class="menu-arrow">›</text>
      </view>
    </view>
    
    <view class="footer">
      <text class="version">v{{ version }}</text>
    </view>
  </view>
</template>

<script lang="uts" setup>
  import { computed } from 'vue'
  import { state, clearLoginState, isLoggedIn } from '@/store/index.uts'
  import { darkModeClass } from '@/composables/useDark.uts'

  type MenuItem = {
    key: string
    icon: string
    text: string
  }

  const userInfo = computed(() => state.userInfo)
  const loggedIn = computed(() => isLoggedIn())

  const paddingBottomStyle = computed(() => {
    const safeAreaBottom = state.safeArea?.bottom || 0
    return `${safeAreaBottom + 100}rpx`
  })

  const version = computed(() => {
    // #ifdef APP || MP-WEIXIN
    try {
      const info = uni.getAppBaseInfo()
      return info.appVersion || '1.0.0'
    } catch {
      return '1.0.0'
    }
    // #endif
    return '1.0.0'
  })

  const menuItems = computed<MenuItem[]>(() => {
    const baseItems = [
      { key: 'settings', icon: '⚙️', text: '设置' },
      { key: 'about', icon: 'ℹ️', text: '关于' },
      { key: 'feedback', icon: '💬', text: '意见反馈' }
    ]
    
    if (loggedIn.value) {
      baseItems.push({ key: 'logout', icon: '🚪', text: '退出登录' })
    }
    
    return baseItems
  })

  const handleUserClick = () => {
    if (!loggedIn.value) {
      uni.navigateTo({ url: '/pages/login/login' })
    }
  }

  const handleMenuClick = (item: MenuItem) => {
    switch (item.key) {
      case 'logout':
        handleLogout()
        break
      case 'settings':
        uni.showToast({ title: '设置功能开发中', icon: 'none' })
        break
      case 'about':
        uni.showToast({ title: '关于我们', icon: 'none' })
        break
      case 'feedback':
        uni.showToast({ title: '意见反馈功能开发中', icon: 'none' })
        break
      default:
        uni.showToast({ title: `点击了${item.text}`, icon: 'none' })
    }
  }

  const handleLogout = () => {
    uni.showModal({
      title: '退出登录',
      content: '确定要退出登录吗？',
      confirmColor: '#667eea',
      success: (res) => {
        if (res.confirm) {
          clearLoginState()
          uni.showToast({ title: '已退出登录', icon: 'success' })
          
          setTimeout(() => {
            uni.switchTab({ url: '/pages/index/index' })
          }, 1500)
        }
      }
    })
  }

  onShow(() => {
    // #ifdef DEBUG
    console.log('Mine Page Show')
    // #endif
  })

  onLoad(() => {
    // #ifdef DEBUG
    console.log('Mine Page Load')
    // #endif
  })
</script>

<style lang="scss">
  .page-container {
    min-height: 100vh;
    background-color: $uni-bg-color-grey;
  }

  .page-container.theme-dark {
    background-color: #1a1a1a;
  }

  .user-card {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    display: flex;
    align-items: center;
    padding: 40rpx;
    margin-bottom: 20rpx;
  }

  .avatar {
    width: 120rpx;
    height: 120rpx;
    background: rgba(255, 255, 255, 0.2);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-right: 30rpx;
    overflow: hidden;
  }

  .avatar-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .avatar-icon {
    font-size: 50rpx;
  }

  .user-info {
    flex: 1;
  }

  .user-name {
    display: block;
    font-size: 36rpx;
    font-weight: 600;
    color: #fff;
    margin-bottom: 8rpx;
  }

  .user-desc {
    font-size: 26rpx;
    color: rgba(255, 255, 255, 0.8);
  }

  .user-arrow {
    width: 60rpx;
    height: 60rpx;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .arrow-icon {
    font-size: 40rpx;
    color: rgba(255, 255, 255, 0.8);
  }

  .menu-list {
    background: $uni-bg-color;
    margin: 0 20rpx 20rpx;
    border-radius: 16rpx;
    overflow: hidden;
  }

  .page-container.theme-dark .menu-list {
    background-color: #2a2a2a;
  }

  .menu-item {
    display: flex;
    align-items: center;
    padding: 30rpx;
    border-bottom: 1rpx solid $uni-border-color;
    
    &:last-child {
      border-bottom: none;
    }
  }

  .menu-icon {
    font-size: 36rpx;
    margin-right: 20rpx;
  }

  .menu-text {
    flex: 1;
    font-size: 30rpx;
    color: $uni-text-color;
  }

  .page-container.theme-dark .menu-text {
    color: #fff;
  }

  .menu-arrow {
    font-size: 36rpx;
    color: $uni-text-color-grey;
  }

  .footer {
    text-align: center;
    padding: 40rpx 0;
  }

  .version {
    font-size: 24rpx;
    color: $uni-text-color-grey;
  }
</style>
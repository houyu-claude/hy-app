      border: 2rpx solid #ddd;
      border-radius: 6rpx;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-right: 12rpx;
      
      &.checked {
        background: linear-gradient(90deg, #667eea, #764ba2);
        border-color: transparent;
      }
    }
    
    .check-icon {
      font-size: 24rpx;

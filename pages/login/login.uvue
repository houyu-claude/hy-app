<template>
  <view class="login-container">
    <view class="login-header">
      <view class="logo-wrapper">
        <view class="logo-icon">
          <text class="logo-text">HY</text>
        </view>
      </view>
      <text class="app-title">houyu-app</text>
      <text class="app-subtitle">欢迎回来</text>
    </view>

    <view class="login-form">
      <view class="tabs-wrapper">
        <view 
          class="tab-item" 
          :class="{ active: loginType === 'password' }"
          @click="loginType = 'password'"
        >
          <text class="tab-text">账号密码</text>
          <view v-if="loginType === 'password'" class="tab-indicator"></view>
        </view>
        <view 
          class="tab-item" 
          :class="{ active: loginType === 'sms' }"
          @click="loginType = 'sms'"
        >
          <text class="tab-text">短信验证</text>
          <view v-if="loginType === 'sms'" class="tab-indicator"></view>
        </view>
      </view>

      <view class="form-content">
        <view class="form-item">
          <view class="input-icon">
            <text class="icon-text">👤</text>
          </view>
          <input 
            class="form-input" 
            v-model="form.username" 
            :placeholder="loginType === 'password' ? '请输入用户名' : '请输入手机号'"
            :type="loginType === 'password' ? 'text' : 'number'"
            placeholder-class="input-placeholder"
          />
        </view>

        <view class="form-item" v-if="loginType === 'password'">
          <view class="input-icon">
            <text class="icon-text">🔒</text>
          </view>
          <input 
            class="form-input" 
            v-model="form.password" 
            placeholder="请输入密码（至少6位）"
            type="password"
            placeholder-class="input-placeholder"
          />
          <text v-if="!isPasswordValid && form.password" class="password-tip">密码至少6位</text>
        </view>

        <view class="form-item" v-else>
          <view class="input-icon">
            <text class="icon-text">📱</text>
          </view>
          <input 
            class="form-input" 
            v-model="form.smsCode" 
            placeholder="请输入6位验证码"
            type="number"
            placeholder-class="input-placeholder"
          />
          <view 
            class="sms-btn" 
            :class="{ disabled: !canSendSms || smsCountdown > 0 }"
            @click="sendSmsCode"
          >
            <text class="sms-text">{{ smsCountdown > 0 ? smsCountdown + 's' : '获取验证码' }}</text>
          </view>
        </view>

        <view v-if="loginType === 'password'" class="remember-wrapper">
          <view 
            class="remember-checkbox" 
            :class="{ checked: rememberMe }"
            @click="rememberMe = !rememberMe"
          >
            <text v-if="rememberMe" class="check-icon">✓</text>
          </view>
          <text class="remember-text">记住我</text>
          <text class="forgot-text" @click="handleForgotPassword">忘记密码?</text>
        </view>
      </view>

      <view 
        class="login-btn" 
        :class="{ disabled: !canLogin || isLoading }"
        @click="handleLogin"
      >
        <text class="login-btn-text">{{ loginType === 'password' ? '登录' : '短信验证登录' }}</text>
      </view>

      <view class="other-options">
        <text class="divider-text">其他登录方式</text>
        <view class="social-wrapper">
          <view class="social-item" @click="handleSocialLogin('qq')">
            <text class="social-icon">🐧</text>
            <text class="social-text">QQ</text>
          </view>
          <view class="social-item" @click="handleSocialLogin('wechat')">
            <text class="social-icon">💬</text>
            <text class="social-text">微信</text>
          </view>
          <view class="social-item" @click="handleSocialLogin('email')">
            <text class="social-icon">📧</text>
            <text class="social-text">邮箱</text>
          </view>
        </view>
      </view>

      <view class="register-wrapper">
        <text class="register-text">还没有账号?</text>
        <text class="register-link" @click="handleRegister">立即注册</text>
      </view>
    </view>

    <view class="login-footer">
      <text class="footer-text">登录即表示同意</text>
      <text class="footer-link" @click="showAgreement">《用户协议》</text>
      <text class="footer-text">和</text>
      <text class="footer-link" @click="showPrivacy">《隐私政策》</text>
    </view>
  </view>
</template>

<script setup lang="uts">
import { ref, computed } from 'vue'
import { setUserInfo, setTokenInfo, TokenInfo } from '@/store/index.uts'
import { authApi, AppError } from '@/api/request.uts'

const loginType = ref<'password' | 'sms'>('password')
const rememberMe = ref(false)
const smsCountdown = ref(0)
const isLoading = ref(false)

const form = ref({
  username: '',
  password: '',
  smsCode: ''
})

const PASSWORD_MIN_LENGTH = 6
const SMS_CODE_LENGTH = 6

const isPasswordValid = computed(() => {
  return form.value.password.length >= PASSWORD_MIN_LENGTH
})

const isSmsCodeValid = computed(() => {
  return form.value.smsCode.length === SMS_CODE_LENGTH
})

const canLogin = computed(() => {
  if (loginType.value === 'password') {
    return form.value.username.trim() && form.value.password.trim() && isPasswordValid.value
  } else {
    return form.value.username.trim() && isSmsCodeValid.value && validatePhone(form.value.username)
  }
})

const validatePhone = (phone: string): boolean => {
  return /^1[3-9]\d{9}$/.test(phone)
}

const canSendSms = computed(() => {
  return validatePhone(form.value.username.trim())
})

const getLoginErrorMsg = (code: number): string => {
  const errorMap: Record<number, string> = {
    1001: '用户名不存在',
    1002: '密码错误',
    1003: '验证码错误或已过期',
    1004: '账号已被锁定，请稍后重试',
    1005: '该手机号未注册',
    1006: '验证码发送过于频繁',
    401: '登录已过期，请重新登录',
    429: '请求过于频繁，请稍后重试',
    500: '服务器繁忙，请稍后重试'
  }
  return errorMap[code] || '登录失败，请稍后重试'
}

const getSmsErrorMsg = (code: number): string => {
  const errorMap: Record<number, string> = {
    1005: '该手机号未注册',
    1006: '该号码已被限制，请明日再试',
    429: '请求过于频繁，请稍后重试',
    500: '短信服务暂时不可用，请稍后重试'
  }
  return errorMap[code] || '短信发送失败，请稍后重试'
}

const handleError = (error: AppError, context: 'login' | 'sms') => {
  let message = error.message
  
  if (error.type === 'network') {
    message = '网络异常，请检查网络连接'
  } else if (error.type === 'timeout') {
    message = '请求超时，请稍后重试'
  } else if (error.type === 'system') {
    message = '系统繁忙，请稍后重试'
  } else if (error.code !== 0) {
    message = context === 'login' ? getLoginErrorMsg(error.code) : getSmsErrorMsg(error.code)
  }
  
  uni.showToast({ title: message, icon: 'none' })
}

const sendSmsCode = async () => {
  const phone = form.value.username.trim()
  
  if (!phone) {
    uni.showToast({ title: '请输入手机号', icon: 'none' })
    return
  }
  
  if (!validatePhone(phone)) {
    uni.showToast({ title: '请输入正确的手机号', icon: 'none' })
    return
  }
  
  if (smsCountdown.value > 0) return

  try {
    await authApi.sendSmsCode(phone)
    smsCountdown.value = 60
    
    const timer = setInterval(() => {
      smsCountdown.value--
      if (smsCountdown.value <= 0) {
        clearInterval(timer)
      }
    }, 1000)
    
    uni.showToast({ title: '验证码已发送', icon: 'success' })
  } catch (error) {
    console.error('发送验证码失败:', error)
    if (error instanceof AppError) {
      handleError(error, 'sms')
    } else {
      uni.showToast({ title: '短信发送失败，请稍后重试', icon: 'none' })
    }
  }
}

const handleLogin = async () => {
  if (!canLogin.value || isLoading.value) return
  
  const username = form.value.username.trim()
  
  if (loginType.value === 'sms' && !validatePhone(username)) {
    uni.showToast({ title: '请输入正确的手机号', icon: 'none' })
    return
  }

  if (loginType.value === 'password' && !isPasswordValid.value) {
    uni.showToast({ title: '密码至少需要6位', icon: 'none' })
    return
  }

  isLoading.value = true
  
  try {
    let response
    
    if (loginType.value === 'password') {
      response = await authApi.loginByPassword(username, form.value.password)
    } else {
      response = await authApi.loginBySms(username, form.value.smsCode)
    }

    if (response.success && response.data) {
      const { accessToken, refreshToken, expiresIn, userInfo } = response.data
      
      const tokenInfo: TokenInfo = {
        accessToken,
        refreshToken,
        expiresAt: Date.now() + (expiresIn || 7200) * 1000
      }
      
      setTokenInfo(tokenInfo)
      setUserInfo({
        nickName: userInfo.nickName || username,
        avatarUrl: userInfo.avatarUrl
      })
      
      uni.showToast({ title: '登录成功', icon: 'success' })
      
      setTimeout(() => {
        uni.switchTab({ url: '/pages/index/index' })
      }, 1500)
    }
  } catch (error) {
    console.error('登录失败:', error)
    if (error instanceof AppError) {
      handleError(error, 'login')
    } else {
      uni.showToast({ title: '登录失败，请稍后重试', icon: 'none' })
    }
  } finally {
    isLoading.value = false
  }
}

const handleForgotPassword = () => {
  uni.showToast({ title: '忘记密码功能开发中', icon: 'none' })
}

const handleSocialLogin = (type: string) => {
  uni.showToast({ title: `${type}登录开发中`, icon: 'none' })
}

const handleRegister = () => {
  uni.showToast({ title: '注册功能开发中', icon: 'none' })
}

const showAgreement = () => {
  uni.showToast({ title: '用户协议', icon: 'none' })
}

const showPrivacy = () => {
  uni.showToast({ title: '隐私政策', icon: 'none' })
}
</script>


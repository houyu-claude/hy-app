<script setup lang="uts">
  import { state, setStatusBarHeight, setSafeArea, setLifeCycleNum, checkSystemTheme } from '@/store/index.uts'

  const ERROR_LOG_KEY = 'HY_APP_ERROR_LOG'
  const MAX_ERROR_LOG_SIZE = 100
  let exitTimer: ReturnType<typeof setTimeout> | null = null

  type ErrorLogEntry = {
    message: string
    timestamp: number
    lifeCycleNum: number
  }

  const saveErrorLog = (err: string) => {
    try {
      const rawLogs = uni.getStorageSync(ERROR_LOG_KEY)
      const parsed = JSON.parse(rawLogs as string)
      const logs: ErrorLogEntry[] = Array.isArray(parsed) ? (parsed as ErrorLogEntry[]) : []
      const errorLog: ErrorLogEntry = {
        message: err,
        timestamp: Date.now(),
        lifeCycleNum: state.lifeCycleNum
      }
      const appendedLogs = [...logs, errorLog]
      const newLogs = appendedLogs.length > MAX_ERROR_LOG_SIZE ? appendedLogs.slice(1) : appendedLogs
      uni.setStorageSync(ERROR_LOG_KEY, JSON.stringify(newLogs))
    } catch {
      
    }
  }

  onLaunch((res: OnLaunchOptions) => {
    // #ifdef DEBUG
    console.log('App Launch', res)
    // #endif
    setLifeCycleNum(state.lifeCycleNum + 1000)
    
    uni.getSystemInfo({
      success: (sysInfo: GetSystemInfoResult) => {
        if (sysInfo.statusBarHeight) {
          setStatusBarHeight(sysInfo.statusBarHeight)
        }
        if (sysInfo.safeArea) {
          setSafeArea(sysInfo.safeArea)
        }
      }
    })
    
    checkSystemTheme()
  })

  onAppShow((res: OnShowOptions) => {
    // #ifdef DEBUG
    console.log('App Show', res)
    // #endif
    setLifeCycleNum(state.lifeCycleNum + 100)
  })

  onAppHide(() => {
    // #ifdef DEBUG
    console.log('App Hide')
    // #endif
    setLifeCycleNum(state.lifeCycleNum - 100)
  })

  onError((err: string) => {
    // #ifdef DEBUG
    console.log('App Error', err)
    // #endif
    saveErrorLog(err)
    
    // #ifdef APP-ANDROID || WEB || MP-WEIXIN || APP-HARMONY
    uni.report({
      name: 'uni-app-error',
      options: err,
      success: (res) => {
        // #ifdef DEBUG
        console.log('Error reported:', res)
        // #endif
      },
      fail: (error) => {
        // #ifdef DEBUG
        console.log('Report failed:', error)
        // #endif
      }
    })
    // #endif
  })

  // #ifdef APP-ANDROID || APP-HARMONY
  onLastPageBackPress(() => {
    if (exitTimer) {
      uni.exit()
    } else {
      uni.showToast({
        title: '再按一次退出应用',
        position: 'bottom'
      })
      exitTimer = setTimeout(() => {
        exitTimer = null
      }, 2000)
    }
  })

  onExit(() => {
    // #ifdef DEBUG
    console.log('App Exit')
    // #endif
    setLifeCycleNum(state.lifeCycleNum - 1000)
    if (exitTimer) {
      clearTimeout(exitTimer)
    }
  })
  // #endif
</script>

<style>
  @import "./common/uni.css";
</style>
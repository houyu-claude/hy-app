export type SafeArea = {
  top: number,
  right: number,
  bottom: number,
  left: number,
  width: number,
  height: number,
}

export type UserInfo = {
  nickName: string,
  avatarUrl?: string
}

export type TokenInfo = {
  accessToken: string
  refreshToken: string
  expiresAt: number
}

type State = {
  lifeCycleNum: number
  statusBarHeight: number
  safeArea: SafeArea
  isDarkMode: boolean
  userInfo: UserInfo | null
  tokenInfo: TokenInfo | null
}

const STORAGE_KEYS = {
  USER_INFO: 'HY_USER_INFO',
  TOKEN_INFO: 'HY_TOKEN_INFO',
  ENCRYPTED_TOKEN: 'HY_ENCRYPTED_TOKEN'
}

export const state = reactive({
  lifeCycleNum: 0,
  statusBarHeight: 0,
  safeArea: {
    top: 0,
    right: 0,
    bottom: 0,
    left: 0,
    width: 0,
    height: 0,
  },
  isDarkMode: false,
  userInfo: null,
  tokenInfo: null
} as State)

export const setLifeCycleNum = (num: number) => {
  state.lifeCycleNum = num
}

export const setStatusBarHeight = (height: number) => {
  state.statusBarHeight = height
}

export const setSafeArea = (value: SafeArea) => {
  state.safeArea = value
}

export const setUserInfo = (userInfo: UserInfo | null) => {
  state.userInfo = userInfo
  if (userInfo) {
    uni.setStorageSync(STORAGE_KEYS.USER_INFO, JSON.stringify(userInfo))
  } else {
    uni.removeStorageSync(STORAGE_KEYS.USER_INFO)
  }
}

export const setTokenInfo = (tokenInfo: TokenInfo | null) => {
  state.tokenInfo = tokenInfo
  if (tokenInfo) {
    uni.setStorageSync(STORAGE_KEYS.TOKEN_INFO, JSON.stringify(tokenInfo))
  } else {
    uni.removeStorageSync(STORAGE_KEYS.TOKEN_INFO)
    uni.removeStorageSync(STORAGE_KEYS.ENCRYPTED_TOKEN)
  }
}

export const isTokenExpired = (): boolean => {
  if (!state.tokenInfo) return true
  return Date.now() >= state.tokenInfo.expiresAt
}

export const refreshToken = async (): Promise<boolean> => {
  if (!state.tokenInfo?.refreshToken) {
    return false
  }
  
  try {
    const response = await fetch('/api/auth/refresh', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json'
      },
      body: JSON.stringify({
        refreshToken: state.tokenInfo.refreshToken
      })
    })
    
    const data = await response.json()
    
    if (data.success && data.data) {
      const newTokenInfo: TokenInfo = {
        accessToken: data.data.accessToken,
        refreshToken: data.data.refreshToken || state.tokenInfo.refreshToken,
        expiresAt: Date.now() + (data.data.expiresIn || 7200) * 1000
      }
      setTokenInfo(newTokenInfo)
      return true
    }
    return false
  } catch {
    return false
  }
}

export const restoreLoginState = (): boolean => {
  try {
    const userInfoStr = uni.getStorageSync(STORAGE_KEYS.USER_INFO)
    const tokenInfoStr = uni.getStorageSync(STORAGE_KEYS.TOKEN_INFO)
    
    if (userInfoStr) {
      state.userInfo = JSON.parse(userInfoStr) as UserInfo
    }
    
    if (tokenInfoStr) {
      state.tokenInfo = JSON.parse(tokenInfoStr) as TokenInfo
    }
    
    return !!state.userInfo && !!state.tokenInfo
  } catch {
    return false
  }
}

export const clearLoginState = () => {
  state.userInfo = null
  state.tokenInfo = null
  uni.removeStorageSync(STORAGE_KEYS.USER_INFO)
  uni.removeStorageSync(STORAGE_KEYS.TOKEN_INFO)
  uni.removeStorageSync(STORAGE_KEYS.ENCRYPTED_TOKEN)
}

export const isLoggedIn = (): boolean => {
  return !!state.userInfo && !!state.tokenInfo && !isTokenExpired()
}

const resolveTheme = (appTheme: string, osTheme?: string): boolean => {
  const resolvedTheme = appTheme == "auto" ? (osTheme ?? 'light') : (appTheme ?? 'light')
  return resolvedTheme == 'dark'
}

export const checkSystemTheme = () => {
  // #ifdef WEB || MP-WEIXIN
  uni.offHostThemeChange()
  const info = uni.getAppBaseInfo();
  state.isDarkMode = info.hostTheme === 'dark';
  uni.onHostThemeChange((result) => {
    state.isDarkMode = result.hostTheme === 'dark';
  });
  // #endif
  // #ifdef APP
  uni.offAppThemeChange()
  uni.getSystemInfo({
    success: (res: GetSystemInfoResult) => {
      state.isDarkMode = resolveTheme(res.appTheme ?? 'light', res.osTheme)
    }
  })
  uni.onAppThemeChange((res: AppThemeChangeResult) => {
    state.isDarkMode = resolveTheme(res.appTheme ?? 'light', undefined)
  })
  // #endif
}
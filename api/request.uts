import { state, clearLoginState, refreshToken } from '@/store/index.uts'

export type RequestOptions = {
  url: string
  method?: 'GET' | 'POST' | 'PUT' | 'DELETE'
  data?: Record<string, any>
  header?: Record<string, string>
  showLoading?: boolean
  loadingText?: string
  timeout?: number
}

export type ResponseData<T = any> = {
  success: boolean
  code: number
  message: string
  data: T
}

export class AppError extends Error {
  code: number
  type: 'network' | 'timeout' | 'auth' | 'business' | 'system'

  constructor(message: string, code: number = 0, type: 'network' | 'timeout' | 'auth' | 'business' | 'system' = 'business') {
    super(message)
    this.code = code
    this.type = type
    this.name = 'AppError'
  }
}

const BASE_URL = '/api'
const DEFAULT_TIMEOUT = 30000

const checkNetwork = (): Promise<boolean> => {
  return new Promise((resolve) => {
    uni.getNetworkType({
      success: (res) => {
        resolve(res.networkType !== 'none')
      },
      fail: () => {
        resolve(true)
      },
      complete: () => {}
    })
  })
}

export const request = async <T = any>(options: RequestOptions): Promise<ResponseData<T>> => {
  const { 
    url, 
    method = 'GET', 
    data = {}, 
    header = {}, 
    showLoading = true, 
    loadingText = '加载中...',
    timeout = DEFAULT_TIMEOUT
  } = options

  const isOnline = await checkNetwork()
  if (!isOnline) {
    throw new AppError('网络连接异常，请检查网络', -1, 'network')
  }

  if (showLoading) {
    uni.showLoading({ title: loadingText, mask: true })
  }

  try {
    const authHeader: Record<string, string> = {}
    
    if (state.tokenInfo?.accessToken) {
      authHeader['Authorization'] = `Bearer ${state.tokenInfo.accessToken}`
    }

    const response = await new Promise<{ statusCode: number; data: ResponseData<T> }>((resolve, reject) => {
      let timeoutTimer: ReturnType<typeof setTimeout> | null = null
      
      if (timeout > 0) {
        timeoutTimer = setTimeout(() => {
          reject(new AppError('请求超时', -2, 'timeout'))
        }, timeout)
      }

      uni.request({
        url: BASE_URL + url,
        method,
        data,
        header: {
          'Content-Type': 'application/json',
          ...authHeader,
          ...header
        },
        timeout,
        success: (res) => {
          if (timeoutTimer) {
            clearTimeout(timeoutTimer)
          }
          resolve({
            statusCode: res.statusCode,
            data: res.data as ResponseData<T>
          })
        },
        fail: (err) => {
          if (timeoutTimer) {
            clearTimeout(timeoutTimer)
          }
          reject(new AppError(err.errMsg || '请求失败', -3, 'network'))
        }
      })
    })

    if (response.statusCode === 401 && state.tokenInfo?.refreshToken) {
      const refreshed = await refreshToken()
      
      if (refreshed) {
        return await request({ ...options, showLoading: false })
      } else {
        clearLoginState()
        throw new AppError('登录已过期，请重新登录', 401, 'auth')
      }
    }

    const result = response.data

    if (!result.success) {
      let errorType: 'auth' | 'business' | 'system' = 'business'
      
      if (result.code === 401) {
        errorType = 'auth'
        clearLoginState()
      } else if (result.code >= 500) {
        errorType = 'system'
      }
      
      throw new AppError(result.message, result.code, errorType)
    }

    return result

  } catch (error) {
    if (!(error instanceof AppError)) {
      throw new AppError(error instanceof Error ? error.message : '请求失败', -4)
    }
    throw error
  } finally {
    if (showLoading) {
      uni.hideLoading()
    }
  }
}

export const authApi = {
  loginByPassword: async (username: string, password: string) => {
    return request({
      url: '/auth/login',
      method: 'POST',
      data: { username, password },
      showLoading: true,
      loadingText: '登录中...'
    })
  },

  loginBySms: async (phone: string, smsCode: string) => {
    return request({
      url: '/auth/login/sms',
      method: 'POST',
      data: { phone, smsCode },
      showLoading: true,
      loadingText: '验证中...'
    })
  },

  sendSmsCode: async (phone: string) => {
    return request({
      url: '/auth/sms/code',
      method: 'POST',
      data: { phone },
      showLoading: true,
      loadingText: '发送中...'
    })
  },

  logout: async () => {
    return request({
      url: '/auth/logout',
      method: 'POST',
      showLoading: true,
      loadingText: '退出中...'
    })
  },

  getUserInfo: async () => {
    return request({
      url: '/auth/user/info',
      method: 'GET',
      showLoading: false
    })
  }
}